{
  "expo": {
    "name": "Komodo",
    "slug": "komodo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ikona.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16121a",
    "scheme": "komodo",
    "ios": {
      "bundleIdentifier": "ba.komodo.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": ["applinks:komodo.ba"],
      "infoPlist": {
        "NSCameraUsageDescription": "Komodo koristi kameru kad butik snima video proizvoda za oglas.",
        "NSMicrophoneUsageDescription": "Komodo koristi mikrofon da snimi zvuk uz video proizvoda za oglas.",
        "NSPhotoLibraryUsageDescription": "Komodo otvara galeriju kad butik bira video proizvoda za oglas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ba.komodo.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ikona-android.png",
        "backgroundColor": "#16121a"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "komodo.ba", "path": "/" },
            { "scheme": "https", "host": "komodo.ba", "pathPrefix": "/api/auth/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16121a"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/obavjestenje.png",
          "color": "#ff6a4d",
          "defaultChannel": "poruke"
        }
      ]
    ],
    "extra": {}
  }
}
