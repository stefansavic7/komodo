{
  "name": "komodo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "start:cluster": "node --env-file=.env src/index.js",
    "test": "node --test --test-concurrency=4 \"test/*.test.mjs\"",
    "test:istovremenost": "node test/opterecenje/istovremenost.mjs",
    "test:opterecenje": "node test/opterecenje/opterecenje.mjs",
    "test:napuni-bazu": "node test/opterecenje/napuni-bazu.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1"
  }
}
