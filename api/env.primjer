# Kopiraj u api/.env i upiši svoje vrijednosti. api/.env se NE commituje i ne šalje u chat.
DATABASE_URL=postgres://postgres:TVOJA_LOZINKA@127.0.0.1:5432/snimi
PORT=3002
HOST=127.0.0.1
# Najveći video u MB
MAX_VIDEO_MB=100

# Adresa aplikacije, ide u linkove u emailovima (potvrda, nova lozinka, nova poruka). Zahtjevi koji mijenjaju
# podatke sa zaglavljem Origin moraju doći s ove adrese (ili istog hosta).
APP_URL=http://127.0.0.1:3002

# Tajni ključ za potpis kolačića uređaja (did). U produkciji obavezan (API bez njega ne starta);
# napravi ga sa: openssl rand -hex 32. U razvoju može ostati prazan (koristi se razvojni ključ).
COOKIE_SECRET=

# Email adrese administratora, odvojene zarezom. Taj nalog u profilu dobija dugme "Administracija".
ADMIN_EMAILS=

# Slanje emaila. Dok je SMTP_URL prazan, emailovi se samo ispišu u terminalu,
# a novi nalozi su odmah potvrđeni. U produkciji obavezan (API bez njega ne starta).
# Primjer: smtps://korisnik:lozinka@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Komodo <no-reply@komodo.ba>
# Najviše emailova za potvrdu u satu (preko toga nalog nastaje, a link se traži kasnije). Zadano 300.
MAIL_POTVRDA_SAT=300

# Expo pristupni token, kad je u Expo projektu uključeno „Enhanced Security for Push Notifications”.
EXPO_ACCESS_TOKEN=

# Bunny Stream (snimci). Dok su prazni, snimci se čuvaju lokalno u api/uploads.
# Library ID, API Key i CDN Hostname nađeš u Bunny → Stream → biblioteka → API.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
# Najveća rezolucija koja se pušta u aplikaciji (240, 360, 720 ili 1080). Zadano 720 — manje troška za isporuku videa.
# VIDEO_MAX_P=720
