# Kopiraj u api/.env i upiši svoje vrijednosti. api/.env se NE commituje i ne šalje u chat.
DATABASE_URL=postgres://postgres:TVOJA_LOZINKA@127.0.0.1:5432/snimi
PORT=3002
HOST=127.0.0.1
# Najveći video u MB
MAX_VIDEO_MB=100

# Adresa aplikacije, ide u linkove u emailovima (potvrda, nova lozinka, nova poruka).
APP_URL=http://127.0.0.1:3002

# Email adrese administratora, odvojene zarezom. Taj nalog u profilu dobija dugme "Administracija".
ADMIN_EMAILS=

# Slanje emaila. Dok je SMTP_URL prazan, emailovi se samo ispišu u terminalu,
# a novi nalozi su odmah potvrđeni. Primjer: smtps://korisnik:lozinka@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Komodo <no-reply@komodo.ba>

# Bunny Stream (snimci). Dok su prazni, snimci se čuvaju lokalno u api/uploads.
# Library ID, API Key i CDN Hostname nađeš u Bunny → Stream → biblioteka → API.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
