# Na serveru: kopiraj u ~/komodo/api/.env. DATABASE_URL, HOST, PORT i UPLOADS_DIR postavlja docker-compose.yml.
# OBAVEZNO: adresa aplikacije; ide u linkove u emailovima, a zahtjevi koji mijenjaju podatke sa zaglavljem
# Origin moraju doći s nje.
APP_URL=https://komodo.ba
# OBAVEZNO: potpis kolačića uređaja (did). Bez njega API u produkciji ne starta. Napravi ga sa:
#   openssl rand -hex 32
COOKIE_SECRET=
# Admin prava postoje tek uz potvrđen email: administrator se prvo registruje i potvrdi email.
ADMIN_EMAILS=
MAX_VIDEO_MB=100

# Email (obavezno na serveru: potvrda emaila, nova lozinka, obavještenja butiku)
SMTP_URL=
MAIL_FROM=Komodo <no-reply@komodo.ba>
# Najviše emailova za potvrdu u satu (preko toga nalog nastaje, a link se traži kasnije). Zadano 300.
MAIL_POTVRDA_SAT=300

# Expo pristupni token (neobavezno): treba samo ako je u Expo projektu uključeno „Enhanced Security for Push
# Notifications”.
EXPO_ACCESS_TOKEN=

# Android kanal za push o sniženjima (mora postojati u mobilnoj aplikaciji; zadano je baš ovo).
PUSH_SNIZENJA_KANAL=snizenja

# Novi (jači) zapis lozinki, scrypt N=2^15. Uključiti u sljedećem izdanju, tek kad se na serveru više ne vraća
# na verziju API-ja koja ga ne zna (stari API ne bi mogao provjeriti nove zapise).
# KOMODO_SCRYPT_V2=1

# Bunny Stream
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=

# --- Otpornost (talas 4; docs/RUNBOOK.md, odjeljak 4a; docs/ARHITEKTURA.md, „Otpornost”). Zadane vrijednosti su
# dobre; mijenjaju se samo po uputstvu iz RUNBOOK-a. ---
# Režim rada za sve klijente: normalno | stedi | hitno. Administrator ga mijenja i u aplikaciji (Administracija →
# Režim rada); izbor administratora ima prednost, „Vrati na podešavanje servera” vraća na ovu vrijednost.
KOMODO_REZIM=normalno
# Rok za jedan upit API-ja (ms; uključuje čekanje na zaključan red). Istekao rok → 503 s Retry-After, nikad 500.
# PG_STATEMENT_TIMEOUT_MS=5000
# Rok za upit pozadinskih poslova (ocjene, brojke, čišćenje, outbox).
# PG_STATEMENT_TIMEOUT_POSAO_MS=120000
# Transakcija koja miruje duže od ovoga se prekida (ne drži zaključane redove).
# PG_IDLE_TX_TIMEOUT_MS=10000
# HTTP: veza bez ijednog bajta ovoliko ms se zatvara (spor upload videa prolazi dok podaci teku); cijeli zahtjev
# (i upload od 110 MB) mora stići za HTTP_REQUEST_TIMEOUT_MS.
# HTTP_CONNECTION_TIMEOUT_MS=120000
# HTTP_REQUEST_TIMEOUT_MS=1800000
# Outbox (push o porukama i sniženjima): najviše pokušaja prije „mrtvog” reda, zakup reda u s (mora biti duži od
# roka zahtjeva prema Expo-u, 10 s), razmak prolaza u ms.
# OUTBOX_POKUSAJA=6
# OUTBOX_ZAKUP_S=120
# OUTBOX_MS=1000
# Sabiranje razlika sviđanja u listings.likes_count (ms).
# KOMODO_SABIR_MS=1000
