# Na serveru: kopiraj u ~/komodo/.env (korijen projekta). Lozinka baze, samo slova i brojevi.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Veličine: odkomentariši TAČNO JEDAN profil ispod (onaj koji odgovara serveru).
# Bez profila važe zadane vrijednosti iz docker-compose.yml (2 procesa, 512 MB API, 512 MB baza).
#
# Pravila po kojima su brojevi izračunati:
# - WORKERS: Node procesa za API. Jedan izdrži ~2.000 zahtjeva/s (mjerenje 19.11.2026.).
#   Na istom serveru radi i baza, pa se jedno ili dva jezgra ostavljaju njoj i Nginxu.
# - NODE_OPTIONS: heap po procesu. WORKERS × max-old-space-size + ~50 MB po procesu
#   (i za glavni proces) mora stati u API_MEM.
# - PG_POOL: konekcija na bazu po procesu. DB_MAX_CONNECTIONS > (WORKERS + 1) × PG_POOL + rezerva
#   (~10–20 za psql, noćnu kopiju i superusera).
# - DB_SHARED_BUFFERS ≈ 25% od DB_MEM; DB_EFFECTIVE_CACHE_SIZE ≈ 75% od DB_MEM (koliko baza može
#   očekivati u kešu; ne zauzima memoriju, samo pomaže planeru upita).
# - DB_WORK_MEM: po operaciji sortiranja; DB_MAX_CONNECTIONS × DB_WORK_MEM + shared_buffers < DB_MEM.
# - Ostatak RAM-a servera (van API_MEM i DB_MEM) ostaje sistemu, Nginxu i kešu diska.
# ---------------------------------------------------------------------------------------------

# (a) Terminkov server, PROBA (2 dijeljena vCPU, 1,9 GB RAM, dijeli se s Terminkom; docs/SERVER.md odjeljak 0).
#     Komodo dobija po 256 MB po kontejneru. Jedan radni proces: dva dijeljena jezgra koristi i Terminko,
#     a dva procesa ne bi sigurno stala u 256 MB. 1 × 128 + 2 × 50 = 228 MB < 256 MB.
#     Konekcije: (1 + 1) × 5 + 10 = 20 < 25. Baza: 25 × 2 + 64 = 114 MB < 256 MB.
# WORKERS=1
# PG_POOL=5
# UV_THREADPOOL_SIZE=4
# API_MEM=256m
# NODE_OPTIONS=--max-old-space-size=128
# DB_MEM=256m
# DB_SHARED_BUFFERS=64MB
# DB_EFFECTIVE_CACHE_SIZE=192MB
# DB_WORK_MEM=2MB
# DB_MAINTENANCE_WORK_MEM=32MB
# DB_MAX_CONNECTIONS=25
# DB_MAX_WAL_SIZE=512MB
# DB_SHM_SIZE=64m

# (b) Hetzner CCX23 (4 dedicated vCPU, 16 GB RAM) — lansiranje.
#     3 procesa (~6.000 zahtjeva/s po mjerenju, jedno jezgro ostaje bazi i Nginxu).
#     API: 3 × 1024 + 4 × 50 = 3.272 MB < 4 GB. Baza 8 GB, ostalih ~4 GB sistemu i kešu diska.
#     Konekcije: (3 + 1) × 10 + 20 = 60. Baza: 60 × 8 + 2.048 = 2,5 GB < 8 GB.
# WORKERS=3
# PG_POOL=10
# API_MEM=4g
# NODE_OPTIONS=--max-old-space-size=1024
# DB_MEM=8g
# DB_SHARED_BUFFERS=2GB
# DB_EFFECTIVE_CACHE_SIZE=6GB
# DB_WORK_MEM=8MB
# DB_MAINTENANCE_WORK_MEM=512MB
# DB_MAX_CONNECTIONS=60
# DB_MAX_WAL_SIZE=2GB
# DB_SHM_SIZE=1g

# (c) Hetzner CCX33 (8 dedicated vCPU, 32 GB RAM) — lansiranje s reklamama (cilj 40.000 istovremenih).
#     6 procesa (dva jezgra ostaju bazi i Nginxu). Ako `docker stats` pod opterećenjem pokaže da baza
#     ima slobodnog procesora, a API je na vrhu, WORKERS se može podići na 7 (pa i DB_MAX_CONNECTIONS).
#     API: 6 × 1024 + 7 × 50 = 6.494 MB < 8 GB. Baza 16 GB, ostalih ~8 GB sistemu i kešu diska.
#     Konekcije: (6 + 1) × 10 + 20 = 90 < 100. Baza: 100 × 16 + 4.096 = 5,6 GB < 16 GB.
# WORKERS=6
# PG_POOL=10
# API_MEM=8g
# NODE_OPTIONS=--max-old-space-size=1024
# DB_MEM=16g
# DB_SHARED_BUFFERS=4GB
# DB_EFFECTIVE_CACHE_SIZE=12GB
# DB_WORK_MEM=16MB
# DB_MAINTENANCE_WORK_MEM=1GB
# DB_MAX_CONNECTIONS=100
# DB_MAX_WAL_SIZE=4GB
# DB_SHM_SIZE=2g

# Zapisivanje svakog zahtjeva u log (samo za traženje greške; pod velikim prometom puni disk i troši procesor).
# LOG_REQUESTS=1
