# Na serveru: kopiraj u ~/komodo/.env (korijen projekta). Lozinka baze, samo slova i brojevi.
POSTGRES_PASSWORD=

# Samo na Terminkovom serveru (proba, docs/SERVER.md odjeljak 0): manja potrošnja memorije.
# Na Komodovom serveru ove redove ostavi zakomentarisane.
# API_MEM=256m
# DB_MEM=256m
# DB_SHARED_BUFFERS=32MB
# DB_MAX_CONNECTIONS=20
# NODE_OPTIONS=--max-old-space-size=160
